        "nothing_selected": "No item selected.",
        "window_systemd_timeout": "Cannot open the window: systemd-run is not responding.",
        "window_start_failed": "Cannot open the window: {detail}",
        "window_open_failed": "Cannot open the window: {detail}",
        "window_opened": "Window opened.",
        "opened_home": "Opened on dropbox.com.",
        "opened_url": "Opened on dropbox.com: {url}",
        "select_one": "Select only one item.",
        "exclude_nothing": "No folder to exclude from sync.",
        "exclude_failed": "Exclusion failed",
        "exclude_timeout": "Exclusion failed: timeout.",
        "excluded_done": "Excluded from sync: {paths}",
        "no_links": "No Dropbox link created for the selected paths.",
        "clipboard_failed": "Could not copy to the clipboard. Links: {urls}",
        "link_copied": "Link copied to the clipboard: {urls}",
