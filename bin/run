LANG = "en"  # set by hello (or --lang in dialog mode); English until then


class Refusal(Exception):
    """Expected, user-facing failure: answered as an error, no traceback."""


def normalize_lang(value):
    """Italian when the language code starts with "it", English otherwise."""
    if isinstance(value, str) and value.strip().lower().startswith("it"):
        return "it"
    return "en"


def tr(key, **fmt):
    """Text for `key` in the current language, with English as the fallback."""
    text = STRINGS.get(LANG, {}).get(key) or STRINGS["en"][key]
    return text.format(**fmt) if fmt else text


def dialog_strings():
    """UI texts of the selective-sync dialog (keys prefixed "dlg_") in the current language."""
    table = STRINGS.get(LANG) or STRINGS["en"]
    return {k: v for k, v in table.items() if k.startswith("dlg_")}


def emit(obj):
    sys.stdout.buffer.write((json.dumps(obj, ensure_ascii=False) + "\n").encode("utf-8"))
    sys.stdout.buffer.flush()


def clip(text, limit=MAX_MESSAGE):
    text = " ".join(str(text).split())
    return text if len(text) <= limit else text[:limit - 1] + "…"


def dropbox_root():
    """Root folder from info.json (personal, then business); Refusal if none."""
    try:
        with open(INFO_PATH, "r", encoding="utf-8") as fh:
            info = json.load(fh)
    except (OSError, ValueError):
        raise Refusal(tr("dropbox_not_found"))
    if isinstance(info, dict):
        for key in ("personal", "business"):
            entry = info.get(key)
            if isinstance(entry, dict):
                root = entry.get("path")
                if isinstance(root, str) and root.startswith("/"):
                    return os.path.normpath(root)
    raise Refusal(tr("dropbox_not_found"))


def valid_paths(req):
    """Lexically normalized absolute paths from the request; strict about types."""
    raw = req.get("paths")
    if raw is None:
        return []
    if not isinstance(raw, list):
        raise Refusal(tr("invalid_paths"))
    result = []
    for p in raw:
        if not isinstance(p, str) or not p.startswith("/"):
            raise Refusal(tr("invalid_paths"))
        result.append(os.path.normpath(p))
    return result


def is_under_root(path, root):
    """Lexical containment at path-component boundaries (no symlink resolution)."""
    if path == root:
        return True
    prefix = root if root.endswith("/") else root + "/"
    return path.startswith(prefix)


def rel_of(path, root):
    """Path relative to the root with "/" separators; "" for the root itself."""
    if path == root:
        return ""
    return path[len(root.rstrip("/")) + 1:]


def is_directory(path):
    try:
        return stat.S_ISDIR(os.lstat(path).st_mode)
    except OSError:
        return False


def run_cli(args, timeout, stdin_data=None, cwd=None):
    """Run a command with list args (never a shell). Returns (rc, stdout, stderr)."""
    proc = subprocess.run(
        args,
        input=stdin_data,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        stdin=DEVNULL if stdin_data is None else None,
        timeout=timeout,
        cwd=cwd,
        check=False,
    )
    return (proc.returncode,
            proc.stdout.decode("utf-8", errors="replace"),
            proc.stderr.decode("utf-8", errors="replace"))


def spawn_detached(cmd):
    """Start a GUI/browser child outside Flea's process group and address-space limit.

    systemd-run --user starts the command as a user unit and returns once it is
    started. Without it, fall back to a new session.
    """
    if NO_SPAWN:
        return
    if os.path.exists(SYSTEMD_RUN):
        try:
            rc = subprocess.run([SYSTEMD_RUN, "--user", "--collect", "--quiet", "--", *cmd],
                                stdin=DEVNULL, stdout=DEVNULL, stderr=DEVNULL,
                                timeout=5, check=False).returncode
        except subprocess.TimeoutExpired:
            raise Refusal(tr("window_systemd_timeout"))
        except OSError:
            rc = -1
        if rc == 0:
            return
    try:
        subprocess.Popen(cmd, stdin=DEVNULL, stdout=DEVNULL, stderr=DEVNULL,
                         start_new_session=True)
    except OSError as exc:
        raise Refusal(tr("window_start_failed", detail=exc))


def excluded_dirs():
    """Absolute paths of folders excluded from sync (`dropbox-cli exclude list`)."""
    try:
        # dropbox-cli prints paths relative to the working directory, so pin it to "/"
        rc, out, _err = run_cli([DBX_CLI, "exclude", "list"], timeout=5, cwd="/")
    except (subprocess.TimeoutExpired, OSError):
        return []
    if rc != 0:
        return []
    return ["/" + ln for ln in out.splitlines()[1:] if ln.strip()]


def do_exclude(paths, root):
    dirs = [p for p in paths if p != root and is_directory(p)]
    if not dirs:
        raise Refusal(tr("exclude_nothing"))
    try:
        rc, _out, err = run_cli([DBX_CLI, "exclude", "add"] + dirs, timeout=6)
    except subprocess.TimeoutExpired:
        raise Refusal(tr("exclude_timeout"))
    if rc != 0:
        detail = (err or "").strip()
        raise Refusal(tr("exclude_failed") + (": " + detail if detail else "."))
    return tr("excluded_done", paths=", ".join(dirs))


def do_sharelink(paths, root):
    deadline = time.monotonic() + SHARELINK_BUDGET
    urls = []
    failed = 0
    skipped = 0
    for path in paths:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            skipped += 1
            continue
        try:
            rc, out, _err = run_cli([DBX_CLI, "sharelink", path], timeout=min(20.0, remaining))
        except subprocess.TimeoutExpired:
            failed += 1
            continue
        found = [ln.strip() for ln in out.splitlines() if ln.strip().startswith("http")]
        if rc == 0 and found:
            urls.extend(found)
        else:
            failed += 1
    if not urls:
        raise Refusal(tr("no_links"))
    text = "\n".join(urls)
    if not NO_SPAWN:
        try:
            rc, _out, _err = run_cli([WL_COPY], timeout=5, stdin_data=text.encode("utf-8"))
        except (subprocess.TimeoutExpired, OSError):
            rc = 1
        if rc != 0:
            raise Refusal(tr("clipboard_failed", urls=", ".join(urls)))
    message = tr("link_copied", urls=", ".join(urls))
    if failed or skipped:
        message += tr("links_missing", n=failed + skipped)
    return message


def do_view(paths, root):
    if len(paths) != 1:
        raise Refusal(tr("select_one"))
    path = paths[0]
    rel = os.path.relpath(path, root)
    if rel == ".":
        url = DROPBOX_HOME
    elif is_directory(path):
        url = DROPBOX_HOME + "/" + quote(rel)
    else:
        parent, name = os.path.split(rel)
        url = DROPBOX_HOME + "/" + quote(parent) + "?preview=" + quote(name)
    spawn_detached([XDG_OPEN, url])
    return tr("opened_url", url=url)


def do_manage(req, paths, root):
    """Open the selective-sync dialog on the best target; never wait for the user."""
    target = root
    if paths and is_directory(paths[0]) and is_under_root(paths[0], root):
        target = paths[0]
    else:
        folder = req.get("folder")
        if isinstance(folder, str) and folder.startswith("/"):
            candidate = os.path.normpath(folder)
            if is_under_root(candidate, root):
                target = candidate
    spawn_detached([PYTHON, "-I", SELF, "--manage", target, "--lang", LANG])
    return tr("window_opened")


def handle_run(req):
    action = req.get("action")
    if action not in ("exclude", "manage", "sharelink", "view"):
        raise Refusal(tr("unknown_action", action=clip(action, 60)))
    root = dropbox_root()
    paths = valid_paths(req)
    if action == "manage":
        return {"op": "done", "message": clip(do_manage(req, paths, root))}
    if action == "view" and not paths:
        # Background menu: the open folder, or the dropbox.com home outside Dropbox.
        folder = req.get("folder")
        if isinstance(folder, str) and folder.startswith("/"):
            folder = os.path.normpath(folder)
            if is_under_root(folder, root):
                return {"op": "done", "message": clip(do_view([folder], root))}
        paths = ["/"]  # outside Dropbox: falls through to the home page below
    if action == "view" and len(paths) == 1 and not is_under_root(paths[0], root):
        spawn_detached([XDG_OPEN, DROPBOX_HOME])
        return {"op": "done", "message": tr("opened_home")}
    if not paths:
        raise Refusal(tr("nothing_selected"))
    for p in paths:
        if not is_under_root(p, root):
            raise Refusal(tr("outside_dropbox"))
    if action == "exclude":
        message = do_exclude(paths, root)
    elif action == "sharelink":
        message = do_sharelink(paths, root)
    else:
        message = do_view(paths, root)
    return {"op": "done", "message": clip(message)}


def handle_request(req):
    global LANG
    op = req.get("op")
    if op == "hello":
        LANG = normalize_lang(req.get("language"))
        return {"op": "ready", "protocolVersion": PROTOCOL_VERSION}
    if op == "settings":
        return {"op": "done"}
    if op == "run":
        return handle_run(req)
    return {"op": "error", "message": clip(tr("unsupported_op", op=op), 120)}


def notify(title, body):
    if NO_SPAWN:
        return
    try:
        subprocess.run([NOTIFY, "-a", "Dropbox", title, clip(body, 200)], stdin=DEVNULL,
                       stdout=DEVNULL, stderr=DEVNULL, timeout=5, check=False)
    except (subprocess.TimeoutExpired, OSError):
        pass


def theme_colors():
    """Current Omarchy palette; the picker has its own fallbacks when this is empty."""
    try:
        with open(THEME_COLORS, "rb") as fh:
            return {k: v for k, v in tomllib.load(fh).items() if isinstance(v, str)}
    except (OSError, ValueError):
        return {}


def ui_font():
    try:
        rc, out, _err = run_cli([FC_MATCH, "-f", "%{family[0]}", "monospace"], timeout=3)
        if rc == 0 and out.strip():
            return out.strip()
    except (subprocess.TimeoutExpired, OSError):
        pass
    return "monospace"


# ---- Dropbox's local copy of the remote tree --------------------------------

def pb_fields(buf):
    """Decode one protobuf message into [(field, wire type, value)]; ValueError if malformed.

    Wire types 0 (varint -> int), 1 and 5 (fixed -> bytes) and 2 (length-delimited -> bytes).
    """
    out = []
    i = 0
    n = len(buf)

    def varint(pos):
        result = shift = 0
        while True:
            if pos >= n or shift > 63:
                raise ValueError("bad varint")
            byte = buf[pos]
            pos += 1
            result |= (byte & 0x7F) << shift
            shift += 7
            if byte < 0x80:
                return result, pos

    while i < n:
        key, i = varint(i)
        field, wire = key >> 3, key & 7
        if field == 0:
            raise ValueError("bad field number")
        if wire == 0:
            value, i = varint(i)
        elif wire == 2:
            length, i = varint(i)
            if i + length > n:
                raise ValueError("truncated field")
            value = bytes(buf[i:i + length])
            i += length
        elif wire in (1, 5):
            size = 8 if wire == 1 else 4
            if i + size > n:
                raise ValueError("truncated field")
            value = bytes(buf[i:i + size])
            i += size
        else:
            raise ValueError("unsupported wire type")
        out.append((field, wire, value))
    return out


ROOT_ID = b"\xff" * 16


def parse_remote_record(value):
    """One `remote_tree` value -> (id, parent id, name, is_dir, size), or None to skip it.

    Layout (observed, not documented): field 1 = node message with 1 = id (16 bytes),
    2 = parent id (16 bytes; the root's parent is 16 x 0xff), 3 = name (utf-8),
    6 present = directory, 5 present = file (5: repeated 1 = block {1: hash, 2: size},
    the file size is the sum of the block sizes). Records without a name (mount points
    of other namespaces) and anything unexpected are skipped.
    """
    try:
        outer = {}
        for field, wire, val in pb_fields(bytes(value)):
            if wire == 2:
                outer.setdefault(field, val)
        if 1 not in outer:
            return None
        inner = {}
        for field, wire, val in pb_fields(outer[1]):
            inner.setdefault(field, (wire, val))
        if 3 not in inner or 1 not in inner or 2 not in inner:
            return None
        node_id, parent = inner[1][1], inner[2][1]
        if inner[3][0] != 2 or len(node_id) != 16 or len(parent) != 16:
            return None
        name = inner[3][1].decode("utf-8")
        if not name or "/" in name:
            return None
        if 6 in inner:
            return node_id, parent, name, True, 0
        if 5 in inner:
            size = 0
            for field, wire, block in pb_fields(inner[5][1]):
                if field == 1 and wire == 2:
                    for bfield, bwire, bval in pb_fields(block):
                        if bfield == 2 and bwire == 0:
                            size += bval
            return node_id, parent, name, False, size
    except (ValueError, UnicodeDecodeError, TypeError):
        pass
    return None


class RemoteTree:
    """Folders and files of Dropbox's synced namespace, indexed by parent id.

    Names compare case-insensitively (Dropbox is case-insensitive).
    """

    def __init__(self):
        self._dirs = {}   # parent id -> {casefolded name: (name, id)}
        self._files = {}  # parent id -> [(name, size)]

    @classmethod
    def from_rows(cls, rows):
        tree = cls()
        for _key, value in rows:
            rec = parse_remote_record(value)
            if rec is None:
                continue
            node_id, parent, name, is_dir, size = rec
            if is_dir:
                tree._dirs.setdefault(parent, {})[name.casefold()] = (name, node_id)
            else:
                tree._files.setdefault(parent, []).append((name, size))
        return tree

    def subdirs(self, rid):
        """[(name, id)] of the folders directly inside folder `rid`, sorted by name."""
        found = self._dirs.get(rid, {})
        return sorted(found.values(), key=lambda e: (e[0].casefold(), e[0]))

    def child(self, rid, name):
        entry = self._dirs.get(rid, {}).get(name.casefold())
        return entry[1] if entry else None

    def files(self, rid):
        """[(name, size)] of the files directly inside folder `rid`, sorted by name."""
        return sorted(self._files.get(rid, []), key=lambda e: (e[0].casefold(), e[0]))

    def find(self, rel):
        """Id of the folder at `rel` ("" = the root), or None."""
        rid = ROOT_ID
        for part in [p for p in rel.split("/") if p]:
            rid = self.child(rid, part)
            if rid is None:
                return None
        return rid


def find_nucleus():
    """Newest nucleus.sqlite3 of the running Dropbox instances, or None."""
    pattern = os.environ.get("FLEA_DROPBOX_NUCLEUS") or os.path.join(
        os.path.expanduser("~"), ".dropbox", "instance*", "sync", "nucleus.sqlite3")
    best, best_time = None, -1.0
    for path in glob.glob(pattern):
        try:
            stamp = max(os.stat(path + suffix).st_mtime
                        for suffix in ("", "-wal") if os.path.exists(path + suffix))
        except (OSError, ValueError):
            continue
        if os.path.isfile(path) and stamp > best_time:
            best, best_time = path, stamp
    return best


def load_remote_tree(db_path=None):
    """RemoteTree read from Dropbox's database, or None on any failure.

    The live database (SQLite, WAL mode, written by Dropbox) is never opened: the
    db, -wal and -shm files are copied into a private temporary directory, the copy
    is read, and the directory is removed.
    """
    tmp = None
    conn = None
    try:
        db_path = db_path or find_nucleus()
        if not db_path:
            return None
        tmp = tempfile.mkdtemp(prefix="flea-dropbox-nucleus-",
                               dir=os.environ.get("XDG_RUNTIME_DIR") or None)
        copy = os.path.join(tmp, "nucleus.sqlite3")
        shutil.copyfile(db_path, copy)
        for suffix in ("-wal", "-shm"):
            if os.path.exists(db_path + suffix):
                shutil.copyfile(db_path + suffix, copy + suffix)
        conn = sqlite3.connect(copy)
        return RemoteTree.from_rows(conn.execute("SELECT key, value FROM remote_tree"))
    except (OSError, sqlite3.Error, ValueError, MemoryError):
        return None
    finally:
        if conn is not None:
            try:
                conn.close()
            except sqlite3.Error:
                pass
        if tmp is not None:
            shutil.rmtree(tmp, ignore_errors=True)


def loose_info(remote, rid, sample=LOOSE_SAMPLE):
    """Files directly inside remote folder `rid`: {count, bytes, files:[{name,size}]} or None."""
    if remote is None or rid is None:
        return None
    files = remote.files(rid)
    if not files:
        return None
    return {"count": len(files), "bytes": sum(size for _n, size in files),
            "files": [{"name": n, "size": size} for n, size in files[:sample]]}


# ---- Tree for the dialog -------------------------------------------------------

def build_tree(root, excluded, max_depth=TREE_MAX_DEPTH, max_nodes=TREE_MAX_NODES, remote=None):
    """Folder tree for the dialog: {"nodes": [...], "truncated": bool}.

    Walks local directories under `root` (no symlink following, hidden names
    skipped) down to `max_depth` levels, listing at most `max_nodes` of them.
    Excluded folders do not exist locally: when `remote` (a RemoteTree) knows them,
    their subfolders come from it (synced=False, expandable, so a subfolder can be
    chosen); every excluded path under root is a node (synced=False) in any case,
    placed under the deepest listed ancestor when its own parent is not listed.
    Nodes come depth-first, siblings sorted case-insensitively, each with its
    "parent" rel (None at the top). Excluded nodes whose remote folder directly
    holds files also carry "loose" (see loose_info).
    """
    root = os.path.normpath(root)
    excl = {}
    for path in excluded:
        if isinstance(path, str) and path.startswith("/") and path != root \
                and is_under_root(os.path.normpath(path), root):
            rel = rel_of(os.path.normpath(path), root)
            excl[rel.casefold()] = rel
    excl_children = {}
    for rel in excl.values():
        excl_children.setdefault(rel.rpartition("/")[0], []).append(rel)
    nodes = {}
    state = {"count": 0, "truncated": False}

    # Breadth-first, so a node cap drops the deepest levels, never later top-level folders.
    queue = collections.deque([(root, "", 0, ROOT_ID if remote else None)])
    while queue and not state["truncated"]:
        abs_dir, rel_dir, depth, rid = queue.popleft()
        entries = {}  # casefolded name -> (name, absolute path or None, forced into the list)
        if abs_dir is not None:
            try:
                with os.scandir(abs_dir) as it:
                    for e in it:
                        if not e.name.startswith(".") and e.is_dir(follow_symlinks=False):
                            entries[e.name.casefold()] = (e.name, e.path, False)
            except OSError:
                continue
            for rel in excl_children.get(rel_dir, []):
                name = rel.rpartition("/")[2]
                entries.setdefault(name.casefold(), (name, None, True))
        elif remote is not None and rid is not None:
            for name, _id in remote.subdirs(rid):
                if not name.startswith("."):
                    entries[name.casefold()] = (name, None, False)
        for _fold, (name, path, forced) in sorted(entries.items(),
                                                  key=lambda kv: (kv[0], kv[1][0])):
            if state["count"] >= max_nodes and not forced:
                state["truncated"] = True
                break
            state["count"] += 1
            rel = rel_dir + "/" + name if rel_dir else name
            is_excl = rel.casefold() in excl
            child_rid = remote.child(rid, name) if remote is not None and rid is not None else None
            nodes[rel] = {"rel": rel, "name": name, "depth": depth,
                          "synced": abs_dir is not None and not is_excl,
                          "parent": rel_dir or None}
            if not nodes[rel]["synced"]:
                loose = loose_info(remote, child_rid)
                if loose:
                    nodes[rel]["loose"] = loose
            if depth + 1 < max_depth:
                if not nodes[rel]["synced"]:
                    if child_rid is not None:
                        queue.append((None, rel, depth + 1, child_rid))
                else:
                    queue.append((path, rel, depth + 1, child_rid))

    for rel in sorted(excl.values(), key=lambda r: (r.count("/"), r)):
        if rel in nodes:
            continue
        parts = rel.split("/")
        parent = None
        for k in range(len(parts) - 1, 0, -1):
            anc = nodes.get("/".join(parts[:k]))
            if anc is not None and anc["synced"]:
                parent = anc["rel"]
                break
        depth = nodes[parent]["depth"] + 1 if parent else 0
        nodes[rel] = {"rel": rel, "name": parts[-1], "depth": depth,
                      "synced": False, "parent": parent}

    children = {}
    for node in nodes.values():
        children.setdefault(node["parent"], []).append(node)
    for siblings in children.values():
        siblings.sort(key=lambda n: (n["name"].casefold(), n["name"]))
    ordered = []

    def visit(parent):
        for node in children.get(parent, []):
            item = {"rel": node["rel"], "name": node["name"], "depth": node["depth"],
                    "synced": node["synced"], "parent": node["parent"],
                    "hasChildren": node["rel"] in children}
            if "loose" in node:
                item["loose"] = node["loose"]
            ordered.append(item)
            visit(node["rel"])

    visit(None)
    return {"nodes": ordered, "truncated": state["truncated"]}


def plan_exclusions(nodes, excluded_rels, excl_rels, incl_rels, partial_rels=(),
                    extra_children=None):
    """Desired exclusions after the dialog: (to_add, to_remove), lists of rels.

    The dialog reports the nodes whose effective state changed: `excl_rels` were
    synced and are now off, `incl_rels` were excluded (or under an excluded folder)
    and are now on; a node is on only if every ancestor is on. Rels that do not fit
    (unknown, wrong previous state) are ignored. The result is the minimal set of
    exclusions: the top-most off folders whose parent is on. `partial_rels` are the
    folders that turn on as "partial" (some subfolders stay excluded): their remote
    subfolders that were not listed in the dialog (node cap) stay excluded too, via
    `extra_children(rel)` (names of their remote subfolders; optional).
    `excluded_rels` is the current
    `exclude list`; entries that are not nodes are left alone.
    """
    initial = {n["rel"]: n.get("synced") is True for n in nodes}
    parent = {n["rel"]: n.get("parent") for n in nodes}
    final = dict(initial)
    for rel in excl_rels:
        if isinstance(rel, str) and initial.get(rel) is True:
            final[rel] = False
    for rel in incl_rels:
        if isinstance(rel, str) and initial.get(rel) is False:
            final[rel] = True
    for n in nodes:  # depth-first: parents come first
        p = parent[n["rel"]]
        if p is not None and not final[p]:
            final[n["rel"]] = False
    wanted = {r for r, on in final.items()
              if not on and (parent[r] is None or final[parent[r]])}
    kids = {}
    for rel, p in parent.items():
        kids.setdefault(p, []).append(rel)
    if extra_children is not None:
        for rel in partial_rels:
            if isinstance(rel, str) and final.get(rel) and not initial[rel]:
                listed = {c.rpartition("/")[2].casefold() for c in kids.get(rel, [])}
                for name in extra_children(rel):
                    if name.casefold() not in listed:
                        wanted.add(rel + "/" + name)
    current = {r for r in excluded_rels if isinstance(r, str)}
    kept = {r for r in current if r not in initial}
    desired = wanted | kept
    fold = {r.casefold() for r in current}
    desired_fold = {r.casefold() for r in desired}
    to_add = sorted((r for r in desired if r.casefold() not in fold), key=lambda r: (r.count("/"), r))
    to_remove = sorted((r for r in current if r.casefold() not in desired_fold),
                       key=lambda r: (r.count("/"), r))
    return to_add, to_remove


def manage_dialog(target, lang="en"):
    """Dialog mode (`bin/run --manage <target> --lang <xx>`): choose which folders sync."""
    global LANG
    LANG = normalize_lang(lang)
    try:
        root = dropbox_root()
    except Refusal as exc:
        notify("Dropbox", str(exc))
        return 1
    target = os.path.normpath(target)
    if not is_under_root(target, root):
        target = root
    excluded = excluded_dirs()
    remote = load_remote_tree()  # None: today's behaviour, local folders only
    tree = build_tree(root, excluded, remote=remote)
    target_rel = rel_of(target, root)
    listed = {n["rel"] for n in tree["nodes"]}
    while target_rel and target_rel not in listed:
        target_rel = target_rel.rpartition("/")[0]  # deepest listed ancestor
    payload = json.dumps({"root": root, "target": target_rel, "nodes": tree["nodes"],
                          "truncated": tree["truncated"], "colors": theme_colors(),
                          "font": ui_font(), "strings": dialog_strings()},
                         ensure_ascii=False)
    # The payload goes through a private file: one argv string is capped at 128 KiB.
    env = dict(os.environ, QT_FORCE_STDERR_LOGGING="1", QT_QPA_PLATFORMTHEME="",
               QML_XHR_ALLOW_FILE_READ="1")
    tmpdir = os.environ.get("XDG_RUNTIME_DIR") or None
    try:
        with tempfile.NamedTemporaryFile("w", encoding="utf-8", suffix=".json",
                                         prefix="flea-dropbox-", dir=tmpdir) as fh:
            fh.write(payload)
            fh.flush()
            proc = subprocess.run([QML, PICKER, "--", fh.name], stdin=DEVNULL,
                                  stdout=DEVNULL, stderr=subprocess.PIPE, env=env, check=False)
    except OSError as exc:
        notify("Dropbox", tr("window_open_failed", detail=exc))
        return 1
    lines = proc.stderr.decode("utf-8", errors="replace").splitlines()
    if "qml: DBXDONE" not in lines:
        return 0  # closed without confirming
    excl_rels = [ln[len(QML_EXCL):] for ln in lines if ln.startswith(QML_EXCL)]
    incl_rels = [ln[len(QML_INCL):] for ln in lines if ln.startswith(QML_INCL)]
    part_rels = [ln[len(QML_PART):] for ln in lines if ln.startswith(QML_PART)]
    excluded_rels = [rel_of(os.path.normpath(p), root) for p in excluded
                     if p != root and is_under_root(os.path.normpath(p), root)]

    def extra_children(rel):
        rid = remote.find(rel) if remote is not None else None
        return [name for name, _id in remote.subdirs(rid)] if rid is not None else []

    to_add, to_remove = plan_exclusions(tree["nodes"], excluded_rels, excl_rels, incl_rels,
                                        part_rels, extra_children)
    return apply_changes(root, to_add, to_remove)


def excluded_dirs_checked():
    """Like excluded_dirs() but None when the list cannot be read."""
    try:
        rc, out, _err = run_cli([DBX_CLI, "exclude", "list"], timeout=10, cwd="/")
    except (subprocess.TimeoutExpired, OSError):
        return None
    if rc != 0:
        return None
    return ["/" + ln for ln in out.splitlines()[1:] if ln.strip()]


def describe_changes(to_add, to_remove):
    """Notification text: re-included, partly synced (re-included with exclusions below
    it) and excluded folders, counted as the user sees them."""
    def under(rel, folder):
        return rel.casefold().startswith(folder.casefold() + "/")

    partial = [r for r in to_remove if any(under(a, r) for a in to_add)]
    full = len(to_remove) - len(partial)
    excluded = len([a for a in to_add if not any(under(a, r) for r in to_remove)])
    parts = []
    if excluded:
        parts.append(tr("excluded_one" if excluded == 1 else "excluded_many", n=excluded))
    if full:
        parts.append(tr("included_one" if full == 1 else "included_many", n=full))
    if partial:
        parts.append(tr("partial_one" if len(partial) == 1 else "partial_many", n=len(partial)))
    return ", ".join(parts)


def apply_changes(root, to_add, to_remove, sleep=time.sleep, clock=time.monotonic,
                  budget=APPLY_BUDGET, delay=APPLY_RETRY_DELAY):
    """Apply a plan with dropbox-cli, then notify a summary.

    Removals go first, in one call. `exclude add` does nothing (silently) for a path
    whose parent is still excluded, and a re-included folder shows its subfolders
    locally only after about a second; so each add is retried, checked against
    `exclude list`, until it appears there or `budget` seconds pass. Never creates
    local folders (that would produce selective-sync conflict copies).
    """
    if not to_add and not to_remove:
        notify("Dropbox", tr("no_sync_changes"))
        return 0
    try:
        if to_remove:
            paths = [os.path.join(root, r) for r in to_remove]
            rc, _out, err = run_cli([DBX_CLI, "exclude", "remove"] + paths, timeout=120, cwd="/")
            if rc != 0:
                detail = (err or "").strip()
                notify("Dropbox", tr("operation_failed") + (": " + detail if detail else "."))
                return rc or 1
        pending = list(to_add)
        deadline = clock() + budget
        while pending:
            paths = [os.path.join(root, r) for r in pending]
            rc, _out, err = run_cli([DBX_CLI, "exclude", "add"] + paths, timeout=60, cwd="/")
            if rc != 0:
                detail = (err or "").strip()
                notify("Dropbox", tr("operation_failed") + (": " + detail if detail else "."))
                return rc or 1
            current = excluded_dirs_checked()
            if current is None:
                break  # cannot verify: trust the exit status
            have = {c.casefold() for c in current}
            pending = [r for r in pending if os.path.join(root, r).casefold() not in have]
            if pending:
                if clock() >= deadline:
                    # Roll back: re-exclude what was re-included, so a parent whose
                    # subfolders could not be excluded is not downloaded in full.
                    if to_remove:
                        run_cli([DBX_CLI, "exclude", "add"]
                                + [os.path.join(root, r) for r in to_remove], timeout=60, cwd="/")
                    notify("Dropbox", tr("partial_incomplete", paths=", ".join(pending)))
                    return 1
                sleep(delay)
    except subprocess.TimeoutExpired:
        notify("Dropbox", tr("operation_timeout"))
        return 1
    except OSError as exc:
        notify("Dropbox", tr("operation_failed") + ": " + str(exc))
        return 1
    notify("Dropbox", tr("sync_updated", changes=describe_changes(to_add, to_remove)))
    return 0


def parse_manage_args(args):
    """Parse the dialog arguments `--manage <target> [--lang <xx>]` (program name excluded).

    Returns (target, lang). Raises ValueError on any other shape.
    """
    if len(args) < 2 or args[0] != "--manage":
        raise ValueError("expected --manage <target>")
    target = args[1]
    rest = list(args[2:])
    lang = "en"
    if rest:
        if len(rest) != 2 or rest[0] != "--lang":
            raise ValueError("expected --lang <xx>")
        lang = normalize_lang(rest[1])
    return target, lang


def main():
    """Serve protocol requests from stdin until cancel or EOF."""
    for raw in sys.stdin.buffer:
        line = raw.strip()
        if not line:
            continue
        try:
            req = json.loads(line.decode("utf-8"))
            if not isinstance(req, dict):
                raise ValueError("not an object")
        except (ValueError, UnicodeDecodeError):
            emit({"op": "error", "message": tr("invalid_request")})
            continue
        if req.get("op") == "cancel":
            return 0
        try:
            reply = handle_request(req)
        except Refusal as exc:
            reply = {"op": "error", "message": clip(exc)}
        except Exception as exc:  # never crash the loop
            reply = {"op": "error", "message": clip(tr("internal_error", detail=exc))}
        try:
            emit(reply)
        except BrokenPipeError:
            return 0
    return 0


if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] == "--manage":
        try:
            manage_target, manage_lang = parse_manage_args(sys.argv[1:])
        except ValueError:
            sys.exit(2)
        sys.exit(manage_dialog(manage_target, manage_lang))
    try:
        sys.exit(main())
    except (KeyboardInterrupt, BrokenPipeError):
        sys.exit(0)
