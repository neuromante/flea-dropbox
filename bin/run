#!/usr/bin/python3 -I
"""Flea menu-action plugin: selective Dropbox sync (stdlib only).

Protocol: newline-delimited JSON on stdin/stdout. Stdout carries protocol
replies only; every child process gets stdout/stderr/stdin redirected away
from it. `--manage <folder>` runs the exclusion dialog (launched detached).

Test overrides (environment):
  FLEA_DROPBOX_CLI      dropbox-cli binary (default /usr/bin/dropbox-cli)
  FLEA_DROPBOX_INFO     Dropbox info.json (default ~/.dropbox/info.json)
  FLEA_DROPBOX_NO_SPAWN=1  do not launch GUI/browser/clipboard children
"""
import json
import os
import stat
import subprocess
import sys
import time
import tomllib
from urllib.parse import quote

PROTOCOL_VERSION = 1
MAX_MESSAGE = 300
SHARELINK_BUDGET = 25.0  # seconds for one sharelink request (Flea limit is 30 s)

DBX_CLI = os.environ.get("FLEA_DROPBOX_CLI") or "/usr/bin/dropbox-cli"
INFO_PATH = os.environ.get("FLEA_DROPBOX_INFO") or os.path.join(
    os.path.expanduser("~"), ".dropbox", "info.json")
NO_SPAWN = os.environ.get("FLEA_DROPBOX_NO_SPAWN") == "1"

PYTHON = "/usr/bin/python3"
WL_COPY = "/usr/bin/wl-copy"
QML = "/usr/bin/qml6"
NOTIFY = "/usr/bin/notify-send"
XDG_OPEN = "/usr/bin/xdg-open"
SYSTEMD_RUN = "/usr/bin/systemd-run"
FC_MATCH = "/usr/bin/fc-match"
SELF = os.path.abspath(__file__)
PICKER = os.path.join(os.path.dirname(os.path.dirname(SELF)), "picker.qml")
THEME_COLORS = os.path.join(os.path.expanduser("~"), ".local", "state", "omarchy",
                            "current", "theme", "colors.toml")

OUTSIDE = "Il percorso non è nella cartella Dropbox."
DEVNULL = subprocess.DEVNULL


class Refusal(Exception):
    """Expected, user-facing failure: answered as an error, no traceback."""


def emit(obj):
    sys.stdout.buffer.write((json.dumps(obj, ensure_ascii=False) + "\n").encode("utf-8"))
    sys.stdout.buffer.flush()


def clip(text, limit=MAX_MESSAGE):
    text = " ".join(str(text).split())
    return text if len(text) <= limit else text[:limit - 1] + "…"


def dropbox_root():
    try:
        with open(INFO_PATH, "r", encoding="utf-8") as fh:
            info = json.load(fh)
    except (OSError, ValueError):
        raise Refusal("Cartella Dropbox non trovata (info.json mancante o non valido).")
    if isinstance(info, dict):
        for key in ("personal", "business"):
            entry = info.get(key)
            if isinstance(entry, dict):
                root = entry.get("path")
                if isinstance(root, str) and root.startswith("/"):
                    return os.path.normpath(root)
    raise Refusal("Cartella Dropbox non trovata (info.json mancante o non valido).")


def valid_paths(req):
    """Lexically normalized absolute paths from the request; strict about types."""
    raw = req.get("paths")
    if raw is None:
        return []
    if not isinstance(raw, list):
        raise Refusal("Percorsi non validi.")
    result = []
    for p in raw:
        if not isinstance(p, str) or not p.startswith("/"):
            raise Refusal("Percorsi non validi.")
        result.append(os.path.normpath(p))
    return result


def is_under_root(path, root):
    """Lexical containment at path-component boundaries (no symlink resolution)."""
    if path == root:
        return True
    prefix = root if root.endswith("/") else root + "/"
    return path.startswith(prefix)


def is_directory(path):
    try:
        return stat.S_ISDIR(os.lstat(path).st_mode)
    except OSError:
        return False


def run_cli(args, timeout, stdin_data=None, cwd=None):
    """Run a command with list args (never a shell). Returns (rc, stdout, stderr)."""
    proc = subprocess.run(
        args,
        input=stdin_data,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        stdin=DEVNULL if stdin_data is None else None,
        timeout=timeout,
        cwd=cwd,
        check=False,
    )
    return (proc.returncode,
            proc.stdout.decode("utf-8", errors="replace"),
            proc.stderr.decode("utf-8", errors="replace"))


def spawn_detached(cmd):
    """Start a GUI/browser child outside Flea's process group and address-space limit.

    systemd-run --user starts the command as a user unit and returns once it is
    started. Without it, fall back to a new session.
    """
    if NO_SPAWN:
        return
    if os.path.exists(SYSTEMD_RUN):
        try:
            rc = subprocess.run([SYSTEMD_RUN, "--user", "--collect", "--quiet", "--", *cmd],
                                stdin=DEVNULL, stdout=DEVNULL, stderr=DEVNULL,
                                timeout=5, check=False).returncode
        except subprocess.TimeoutExpired:
            raise Refusal("Impossibile avviare la finestra: systemd-run non risponde.")
        except OSError:
            rc = -1
        if rc == 0:
            return
    try:
        subprocess.Popen(cmd, stdin=DEVNULL, stdout=DEVNULL, stderr=DEVNULL,
                         start_new_session=True)
    except OSError as exc:
        raise Refusal("Impossibile avviare la finestra: %s" % exc)


def excluded_dirs():
    """Absolute paths of folders excluded from sync (`dropbox-cli exclude list`)."""
    try:
        # dropbox-cli prints paths relative to the working directory, so pin it to "/"
        rc, out, _err = run_cli([DBX_CLI, "exclude", "list"], timeout=5, cwd="/")
    except (subprocess.TimeoutExpired, OSError):
        return []
    if rc != 0:
        return []
    return ["/" + ln for ln in out.splitlines()[1:] if ln.strip()]


def excluded_under(folder, root):
    """Excluded folders strictly below `folder` (lexical, component boundary)."""
    prefix = folder.rstrip("/") + "/"
    return sorted(e for e in excluded_dirs() if e.startswith(prefix) and is_under_root(e, root))


def do_exclude(paths, root):
    dirs = [p for p in paths if p != root and is_directory(p)]
    if not dirs:
        raise Refusal("Nessuna cartella da escludere dalla sincronizzazione.")
    try:
        rc, _out, err = run_cli([DBX_CLI, "exclude", "add"] + dirs, timeout=6)
    except subprocess.TimeoutExpired:
        raise Refusal("Esclusione non riuscita: timeout.")
    if rc != 0:
        detail = (err or "").strip()
        raise Refusal("Esclusione non riuscita" + (": " + detail if detail else "."))
    return "Escluse dalla sincronizzazione: " + ", ".join(dirs)


def do_sharelink(paths, root):
    deadline = time.monotonic() + SHARELINK_BUDGET
    urls = []
    failed = 0
    skipped = 0
    for path in paths:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            skipped += 1
            continue
        try:
            rc, out, _err = run_cli([DBX_CLI, "sharelink", path], timeout=min(20.0, remaining))
        except subprocess.TimeoutExpired:
            failed += 1
            continue
        found = [ln.strip() for ln in out.splitlines() if ln.strip().startswith("http")]
        if rc == 0 and found:
            urls.extend(found)
        else:
            failed += 1
    if not urls:
        raise Refusal("Nessun link Dropbox creato per i percorsi selezionati.")
    text = "\n".join(urls)
    if not NO_SPAWN:
        try:
            rc, _out, _err = run_cli([WL_COPY], timeout=5, stdin_data=text.encode("utf-8"))
        except (subprocess.TimeoutExpired, OSError):
            rc = 1
        if rc != 0:
            raise Refusal("Impossibile copiare negli appunti. Link: " + ", ".join(urls))
    message = "Link copiato negli appunti: " + ", ".join(urls)
    if failed or skipped:
        message += " (nessun link per %d percorso/i)" % (failed + skipped)
    return message


def do_view(paths, root):
    if len(paths) != 1:
        raise Refusal("Seleziona un solo elemento.")
    path = paths[0]
    rel = os.path.relpath(path, root)
    if rel == ".":
        url = "https://www.dropbox.com/home"
    elif is_directory(path):
        url = "https://www.dropbox.com/home/" + quote(rel)
    else:
        parent, name = os.path.split(rel)
        url = "https://www.dropbox.com/home/" + quote(parent) + "?preview=" + quote(name)
    spawn_detached([XDG_OPEN, url])
    return "Aperto su dropbox.com: " + url


def do_manage(req, paths, root):
    """Validate the target and start the dialog detached; never wait for the user."""
    if len(paths) == 1 and is_directory(paths[0]):
        target = paths[0]
    else:
        folder = req.get("folder")
        if not isinstance(folder, str) or not folder.startswith("/"):
            raise Refusal("Nessuna cartella di destinazione.")
        target = os.path.normpath(folder)
    if not is_under_root(target, root):
        raise Refusal(OUTSIDE)
    if not excluded_under(target, root):
        raise Refusal("Nessuna cartella esclusa in questa posizione.")
    spawn_detached([PYTHON, "-I", SELF, "--manage", target])
    return "Finestra aperta."


def handle_run(req):
    action = req.get("action")
    if action not in ("exclude", "manage", "sharelink", "view"):
        raise Refusal("Azione sconosciuta: %s" % clip(action, 60))
    root = dropbox_root()
    paths = valid_paths(req)
    if action == "manage":
        return {"op": "done", "message": clip(do_manage(req, paths, root))}
    if not paths:
        raise Refusal("Nessun elemento selezionato.")
    for p in paths:
        if not is_under_root(p, root):
            raise Refusal(OUTSIDE)
    if action == "exclude":
        message = do_exclude(paths, root)
    elif action == "sharelink":
        message = do_sharelink(paths, root)
    else:
        message = do_view(paths, root)
    return {"op": "done", "message": clip(message)}


def handle_request(req):
    op = req.get("op")
    if op == "hello":
        return {"op": "ready", "protocolVersion": PROTOCOL_VERSION}
    if op == "settings":
        return {"op": "done"}
    if op == "run":
        return handle_run(req)
    return {"op": "error", "message": clip("Operazione non supportata: %s" % (op,), 120)}


def notify(title, body):
    if NO_SPAWN:
        return
    try:
        subprocess.run([NOTIFY, "-a", "Dropbox", title, body], stdin=DEVNULL,
                       stdout=DEVNULL, stderr=DEVNULL, timeout=5, check=False)
    except (subprocess.TimeoutExpired, OSError):
        pass


def theme_colors():
    """Current Omarchy palette; the picker has its own fallbacks when this is empty."""
    try:
        with open(THEME_COLORS, "rb") as fh:
            return {k: v for k, v in tomllib.load(fh).items() if isinstance(v, str)}
    except (OSError, ValueError):
        return {}


def ui_font():
    try:
        rc, out, _err = run_cli([FC_MATCH, "-f", "%{family[0]}", "monospace"], timeout=3)
        if rc == 0 and out.strip():
            return out.strip()
    except (subprocess.TimeoutExpired, OSError):
        pass
    return "monospace"


def manage_dialog(folder):
    """Dialog mode (`bin/run --manage <folder>`): pick excluded folders to sync again."""
    try:
        root = dropbox_root()
    except Refusal as exc:
        notify("Dropbox", str(exc))
        return 1
    folder = os.path.normpath(folder)
    if not is_under_root(folder, root):
        notify("Dropbox", OUTSIDE)
        return 1
    candidates = excluded_under(folder, root)
    if not candidates:
        notify("Dropbox", "Nessuna cartella esclusa in questa posizione.")
        return 0
    prefix = folder.rstrip("/") + "/"
    payload = json.dumps({"folder": folder, "items": [c[len(prefix):] for c in candidates],
                          "colors": theme_colors(), "font": ui_font()}, ensure_ascii=False)
    env = dict(os.environ, QT_FORCE_STDERR_LOGGING="1", QT_QPA_PLATFORMTHEME="")
    try:
        proc = subprocess.run([QML, PICKER, "--", payload], stdin=DEVNULL,
                              stdout=DEVNULL, stderr=subprocess.PIPE, env=env, check=False)
    except OSError as exc:
        notify("Dropbox", "Impossibile aprire la finestra: %s" % exc)
        return 1
    lines = proc.stderr.decode("utf-8", errors="replace").splitlines()
    if "qml: DBXDONE" not in lines:
        return 0  # closed without confirming
    allowed = set(candidates)
    chosen = []
    for line in lines:
        if line.startswith("qml: DBXSEL "):
            full = os.path.normpath(prefix + line[len("qml: DBXSEL "):])
            if full in allowed:
                chosen.append(full)
    if not chosen:
        return 0
    try:
        rc, _out, err = run_cli([DBX_CLI, "exclude", "remove"] + chosen, timeout=120, cwd="/")
    except subprocess.TimeoutExpired:
        rc, err = 1, "timeout"
    if rc == 0:
        notify("Dropbox", "Sincronizzazione avviata per %d cartelle." % len(chosen))
    else:
        notify("Dropbox", "Operazione non riuscita: " + (err or "").strip()[:200])
    return rc


def main():
    for raw in sys.stdin.buffer:
        line = raw.strip()
        if not line:
            continue
        try:
            req = json.loads(line.decode("utf-8"))
            if not isinstance(req, dict):
                raise ValueError("not an object")
        except (ValueError, UnicodeDecodeError):
            emit({"op": "error", "message": "Richiesta non valida."})
            continue
        if req.get("op") == "cancel":
            return 0
        try:
            reply = handle_request(req)
        except Refusal as exc:
            reply = {"op": "error", "message": clip(exc)}
        except Exception as exc:  # never crash the loop
            reply = {"op": "error", "message": clip("Errore interno: %s" % exc)}
        try:
            emit(reply)
        except BrokenPipeError:
            return 0
    return 0


if __name__ == "__main__":
    if len(sys.argv) == 3 and sys.argv[1] == "--manage":
        sys.exit(manage_dialog(sys.argv[2]))
    try:
        sys.exit(main())
    except (KeyboardInterrupt, BrokenPipeError):
        sys.exit(0)
