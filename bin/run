        "dlg_keys_hint": "↑↓ naviga   Spazio spunta   ←→ apri/chiudi   / cerca   Esc chiudi",
        "dlg_cancel": "Annulla",
        "dlg_apply": "Applica",
        "dlg_excluded_tag": "esclusa",
        "dlg_pending_exclude": "{n} da escludere",
        "dlg_pending_include": "{n} da reincludere",
        "dlg_no_changes": "Nessuna modifica",
        "dlg_truncated": "Elenco parziale: cartelle troppo profonde o numerose",
        "dlg_no_folders": "Nessuna cartella trovata",
    },
}

LANG = "en"  # set by hello (or --lang in dialog mode); English until then


class Refusal(Exception):
    """Expected, user-facing failure: answered as an error, no traceback."""


def normalize_lang(value):
    """Italian when the language code starts with "it", English otherwise."""
    if isinstance(value, str) and value.strip().lower().startswith("it"):
        return "it"
    return "en"


def tr(key, **fmt):
    """Text for `key` in the current language, with English as the fallback."""
    text = STRINGS.get(LANG, {}).get(key) or STRINGS["en"][key]
    return text.format(**fmt) if fmt else text


def dialog_strings():
    """UI texts of the selective-sync dialog (keys prefixed "dlg_") in the current language."""
    table = STRINGS.get(LANG) or STRINGS["en"]
    return {k: v for k, v in table.items() if k.startswith("dlg_")}


def emit(obj):
    sys.stdout.buffer.write((json.dumps(obj, ensure_ascii=False) + "\n").encode("utf-8"))
    sys.stdout.buffer.flush()


def clip(text, limit=MAX_MESSAGE):
    text = " ".join(str(text).split())
    return text if len(text) <= limit else text[:limit - 1] + "…"


def dropbox_root():
    """Root folder from info.json (personal, then business); Refusal if none."""
    try:
        with open(INFO_PATH, "r", encoding="utf-8") as fh:
            info = json.load(fh)
    except (OSError, ValueError):
        raise Refusal(tr("dropbox_not_found"))
    if isinstance(info, dict):
        for key in ("personal", "business"):
            entry = info.get(key)
            if isinstance(entry, dict):
                root = entry.get("path")
                if isinstance(root, str) and root.startswith("/"):
                    return os.path.normpath(root)
    raise Refusal(tr("dropbox_not_found"))


def valid_paths(req):
    """Lexically normalized absolute paths from the request; strict about types."""
    raw = req.get("paths")
    if raw is None:
        return []
    if not isinstance(raw, list):
        raise Refusal(tr("invalid_paths"))
    result = []
    for p in raw:
        if not isinstance(p, str) or not p.startswith("/"):
            raise Refusal(tr("invalid_paths"))
        result.append(os.path.normpath(p))
    return result


def is_under_root(path, root):
    """Lexical containment at path-component boundaries (no symlink resolution)."""
    if path == root:
        return True
    prefix = root if root.endswith("/") else root + "/"
    return path.startswith(prefix)


def rel_of(path, root):
    """Path relative to the root with "/" separators; "" for the root itself."""
    if path == root:
        return ""
    return path[len(root.rstrip("/")) + 1:]


def is_directory(path):
    try:
        return stat.S_ISDIR(os.lstat(path).st_mode)
    except OSError:
        return False


def run_cli(args, timeout, stdin_data=None, cwd=None):
    """Run a command with list args (never a shell). Returns (rc, stdout, stderr)."""
    proc = subprocess.run(
        args,
        input=stdin_data,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        stdin=DEVNULL if stdin_data is None else None,
        timeout=timeout,
        cwd=cwd,
        check=False,
    )
    return (proc.returncode,
            proc.stdout.decode("utf-8", errors="replace"),
            proc.stderr.decode("utf-8", errors="replace"))


def spawn_detached(cmd):
    """Start a GUI/browser child outside Flea's process group and address-space limit.

    systemd-run --user starts the command as a user unit and returns once it is
    started. Without it, fall back to a new session.
    """
    if NO_SPAWN:
        return
    if os.path.exists(SYSTEMD_RUN):
        try:
            rc = subprocess.run([SYSTEMD_RUN, "--user", "--collect", "--quiet", "--", *cmd],
                                stdin=DEVNULL, stdout=DEVNULL, stderr=DEVNULL,
                                timeout=5, check=False).returncode
        except subprocess.TimeoutExpired:
            raise Refusal(tr("window_systemd_timeout"))
        except OSError:
            rc = -1
        if rc == 0:
            return
    try:
        subprocess.Popen(cmd, stdin=DEVNULL, stdout=DEVNULL, stderr=DEVNULL,
                         start_new_session=True)
    except OSError as exc:
        raise Refusal(tr("window_start_failed", detail=exc))


def excluded_dirs():
    """Absolute paths of folders excluded from sync (`dropbox-cli exclude list`)."""
    try:
        # dropbox-cli prints paths relative to the working directory, so pin it to "/"
        rc, out, _err = run_cli([DBX_CLI, "exclude", "list"], timeout=5, cwd="/")
    except (subprocess.TimeoutExpired, OSError):
        return []
    if rc != 0:
        return []
    return ["/" + ln for ln in out.splitlines()[1:] if ln.strip()]


def do_exclude(paths, root):
    dirs = [p for p in paths if p != root and is_directory(p)]
    if not dirs:
        raise Refusal(tr("exclude_nothing"))
    try:
        rc, _out, err = run_cli([DBX_CLI, "exclude", "add"] + dirs, timeout=6)
    except subprocess.TimeoutExpired:
        raise Refusal(tr("exclude_timeout"))
    if rc != 0:
        detail = (err or "").strip()
        raise Refusal(tr("exclude_failed") + (": " + detail if detail else "."))
    return tr("excluded_done", paths=", ".join(dirs))


def do_sharelink(paths, root):
    deadline = time.monotonic() + SHARELINK_BUDGET
    urls = []
    failed = 0
    skipped = 0
    for path in paths:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            skipped += 1
            continue
        try:
            rc, out, _err = run_cli([DBX_CLI, "sharelink", path], timeout=min(20.0, remaining))
        except subprocess.TimeoutExpired:
            failed += 1
            continue
        found = [ln.strip() for ln in out.splitlines() if ln.strip().startswith("http")]
        if rc == 0 and found:
            urls.extend(found)
        else:
            failed += 1
    if not urls:
        raise Refusal(tr("no_links"))
    text = "\n".join(urls)
    if not NO_SPAWN:
        try:
            rc, _out, _err = run_cli([WL_COPY], timeout=5, stdin_data=text.encode("utf-8"))
        except (subprocess.TimeoutExpired, OSError):
            rc = 1
        if rc != 0:
            raise Refusal(tr("clipboard_failed", urls=", ".join(urls)))
    message = tr("link_copied", urls=", ".join(urls))
    if failed or skipped:
        message += tr("links_missing", n=failed + skipped)
    return message


def do_view(paths, root):
    if len(paths) != 1:
        raise Refusal(tr("select_one"))
    path = paths[0]
    rel = os.path.relpath(path, root)
    if rel == ".":
        url = DROPBOX_HOME
    elif is_directory(path):
        url = DROPBOX_HOME + "/" + quote(rel)
    else:
        parent, name = os.path.split(rel)
        url = DROPBOX_HOME + "/" + quote(parent) + "?preview=" + quote(name)
    spawn_detached([XDG_OPEN, url])
    return tr("opened_url", url=url)


def do_manage(req, paths, root):
    """Open the selective-sync dialog on the best target; never wait for the user."""
    target = root
    if paths and is_directory(paths[0]) and is_under_root(paths[0], root):
        target = paths[0]
    else:
        folder = req.get("folder")
        if isinstance(folder, str) and folder.startswith("/"):
            candidate = os.path.normpath(folder)
            if is_under_root(candidate, root):
                target = candidate
    spawn_detached([PYTHON, "-I", SELF, "--manage", target, "--lang", LANG])
    return tr("window_opened")


def handle_run(req):
    action = req.get("action")
    if action not in ("exclude", "manage", "sharelink", "view"):
        raise Refusal(tr("unknown_action", action=clip(action, 60)))
    root = dropbox_root()
    paths = valid_paths(req)
    if action == "manage":
        return {"op": "done", "message": clip(do_manage(req, paths, root))}
    if action == "view" and not paths:
        # Background menu: the open folder, or the dropbox.com home outside Dropbox.
        folder = req.get("folder")
        if isinstance(folder, str) and folder.startswith("/"):
            folder = os.path.normpath(folder)
            if is_under_root(folder, root):
                return {"op": "done", "message": clip(do_view([folder], root))}
        paths = ["/"]  # outside Dropbox: falls through to the home page below
    if action == "view" and len(paths) == 1 and not is_under_root(paths[0], root):
        spawn_detached([XDG_OPEN, DROPBOX_HOME])
        return {"op": "done", "message": tr("opened_home")}
    if not paths:
        raise Refusal(tr("nothing_selected"))
    for p in paths:
        if not is_under_root(p, root):
            raise Refusal(tr("outside_dropbox"))
    if action == "exclude":
        message = do_exclude(paths, root)
    elif action == "sharelink":
        message = do_sharelink(paths, root)
    else:
        message = do_view(paths, root)
    return {"op": "done", "message": clip(message)}


def handle_request(req):
    global LANG
    op = req.get("op")
    if op == "hello":
        LANG = normalize_lang(req.get("language"))
        return {"op": "ready", "protocolVersion": PROTOCOL_VERSION}
    if op == "settings":
        return {"op": "done"}
    if op == "run":
        return handle_run(req)
    return {"op": "error", "message": clip(tr("unsupported_op", op=op), 120)}


def notify(title, body):
    if NO_SPAWN:
        return
    try:
        subprocess.run([NOTIFY, "-a", "Dropbox", title, clip(body, 200)], stdin=DEVNULL,
                       stdout=DEVNULL, stderr=DEVNULL, timeout=5, check=False)
    except (subprocess.TimeoutExpired, OSError):
        pass


def theme_colors():
    """Current Omarchy palette; the picker has its own fallbacks when this is empty."""
    try:
        with open(THEME_COLORS, "rb") as fh:
            return {k: v for k, v in tomllib.load(fh).items() if isinstance(v, str)}
    except (OSError, ValueError):
        return {}


def ui_font():
    try:
        rc, out, _err = run_cli([FC_MATCH, "-f", "%{family[0]}", "monospace"], timeout=3)
        if rc == 0 and out.strip():
            return out.strip()
    except (subprocess.TimeoutExpired, OSError):
        pass
    return "monospace"


def build_tree(root, excluded, max_depth=TREE_MAX_DEPTH, max_nodes=TREE_MAX_NODES):
    """Folder tree for the dialog: {"nodes": [...], "truncated": bool}.

    Walks local directories under `root` (no symlink following, hidden names
    skipped) down to `max_depth` levels, listing at most `max_nodes` of them.
    Every excluded path under root is also a node (synced=False, no children):
    if its parent is not listed it goes under the deepest listed ancestor.
    Nodes come depth-first, siblings sorted case-insensitively.
    """
    root = os.path.normpath(root)
    excl = set()
    for path in excluded:
        if isinstance(path, str) and path.startswith("/") and path != root \
                and is_under_root(os.path.normpath(path), root):
            excl.add(rel_of(os.path.normpath(path), root))
    nodes = {}
    state = {"count": 0, "truncated": False}

    # Breadth-first, so a node cap drops the deepest levels, never later top-level folders.
    queue = collections.deque([(root, "", 0)])
    while queue and not state["truncated"]:
        abs_dir, rel_dir, depth = queue.popleft()
        try:
            with os.scandir(abs_dir) as it:
                entries = [e for e in it
                           if not e.name.startswith(".") and e.is_dir(follow_symlinks=False)]
        except OSError:
            continue
        entries.sort(key=lambda e: (e.name.casefold(), e.name))
        for entry in entries:
            if state["count"] >= max_nodes:
                state["truncated"] = True
                break
            state["count"] += 1
            rel = rel_dir + "/" + entry.name if rel_dir else entry.name
            is_excl = rel in excl
            nodes[rel] = {"rel": rel, "name": entry.name, "depth": depth,
                          "synced": not is_excl, "parent": rel_dir or None}
            if not is_excl and depth + 1 < max_depth:
                queue.append((entry.path, rel, depth + 1))

    for rel in sorted(excl, key=lambda r: (r.count("/"), r)):
        if rel in nodes:
            continue
        parts = rel.split("/")
        parent = None
        for k in range(len(parts) - 1, 0, -1):
            anc = nodes.get("/".join(parts[:k]))
            if anc is not None and anc["synced"]:
                parent = anc["rel"]
                break
        depth = nodes[parent]["depth"] + 1 if parent else 0
        nodes[rel] = {"rel": rel, "name": parts[-1], "depth": depth,
                      "synced": False, "parent": parent}

    children = {}
    for node in nodes.values():
        children.setdefault(node["parent"], []).append(node)
    for siblings in children.values():
        siblings.sort(key=lambda n: (n["name"].casefold(), n["name"]))
    ordered = []

    def visit(parent):
        for node in children.get(parent, []):
            ordered.append({"rel": node["rel"], "name": node["name"], "depth": node["depth"],
                            "synced": node["synced"], "hasChildren": node["rel"] in children})
            visit(node["rel"])

    visit(None)
    return {"nodes": ordered, "truncated": state["truncated"]}


def plan_changes(nodes, excluded, excl_rels, incl_rels):
    """Validated changes from the dialog answer: (to_add, to_remove) lists of rels.

    to_add: rels that are synced now and were unchecked; only top-most kept.
    to_remove: rels that were excluded and are checked again. Unknown rels are ignored.
    """
    synced = {n["rel"]: n.get("synced") is True for n in nodes}
    excluded = set(excluded)
    add = sorted({r for r in excl_rels if isinstance(r, str) and synced.get(r) is True})
    add = [r for r in add if not any(r.startswith(a + "/") for a in add)]
    remove = sorted({r for r in incl_rels
                     if isinstance(r, str) and r in synced and r in excluded})
    return add, remove


def manage_dialog(target, lang="en"):
    """Dialog mode (`bin/run --manage <target> --lang <xx>`): choose which folders sync."""
    global LANG
    LANG = normalize_lang(lang)
    try:
        root = dropbox_root()
    except Refusal as exc:
        notify("Dropbox", str(exc))
        return 1
    target = os.path.normpath(target)
    if not is_under_root(target, root):
        target = root
    tree = build_tree(root, excluded_dirs())
    target_rel = rel_of(target, root)
    listed = {n["rel"] for n in tree["nodes"]}
    while target_rel and target_rel not in listed:
        target_rel = target_rel.rpartition("/")[0]  # deepest listed ancestor
    payload = json.dumps({"root": root, "target": target_rel, "nodes": tree["nodes"],
                          "truncated": tree["truncated"], "colors": theme_colors(),
                          "font": ui_font(), "strings": dialog_strings()},
                         ensure_ascii=False)
    # The payload goes through a private file: one argv string is capped at 128 KiB.
    env = dict(os.environ, QT_FORCE_STDERR_LOGGING="1", QT_QPA_PLATFORMTHEME="",
               QML_XHR_ALLOW_FILE_READ="1")
    tmpdir = os.environ.get("XDG_RUNTIME_DIR") or None
    try:
        with tempfile.NamedTemporaryFile("w", encoding="utf-8", suffix=".json",
                                         prefix="flea-dropbox-", dir=tmpdir) as fh:
            fh.write(payload)
            fh.flush()
            proc = subprocess.run([QML, PICKER, "--", fh.name], stdin=DEVNULL,
                                  stdout=DEVNULL, stderr=subprocess.PIPE, env=env, check=False)
    except OSError as exc:
        notify("Dropbox", tr("window_open_failed", detail=exc))
        return 1
    lines = proc.stderr.decode("utf-8", errors="replace").splitlines()
    if "qml: DBXDONE" not in lines:
        return 0  # closed without confirming
    excluded = {n["rel"] for n in tree["nodes"] if not n["synced"]}
    excl_rels = [ln[len(QML_EXCL):] for ln in lines if ln.startswith(QML_EXCL)]
    incl_rels = [ln[len(QML_INCL):] for ln in lines if ln.startswith(QML_INCL)]
    to_add, to_remove = plan_changes(tree["nodes"], excluded, excl_rels, incl_rels)
    return apply_changes(root, to_add, to_remove)


def apply_changes(root, to_add, to_remove):
    """Apply the dialog answer with dropbox-cli, then notify a summary."""
    if not to_add and not to_remove:
        notify("Dropbox", tr("no_sync_changes"))
        return 0

    steps = []
    if to_remove:
        steps.append(("remove", to_remove))
    if to_add:
        steps.append(("add", to_add))
    try:
        for verb, rels in steps:
            paths = [os.path.join(root, r) for r in rels]
            rc, _out, err = run_cli([DBX_CLI, "exclude", verb] + paths, timeout=120, cwd="/")
            if rc != 0:
                detail = (err or "").strip()
                notify("Dropbox", tr("operation_failed") + (": " + detail if detail else "."))
                return rc or 1
    except subprocess.TimeoutExpired:
        notify("Dropbox", tr("operation_timeout"))
        return 1
    except OSError as exc:
        notify("Dropbox", tr("operation_failed") + ": " + str(exc))
        return 1
    parts = []
    if to_add:
        parts.append(tr("excluded_one" if len(to_add) == 1 else "excluded_many", n=len(to_add)))
    if to_remove:
        parts.append(tr("included_one" if len(to_remove) == 1 else "included_many",
                        n=len(to_remove)))
    notify("Dropbox", tr("sync_updated", changes=", ".join(parts)))
    return 0


def parse_manage_args(args):
    """Parse the dialog arguments `--manage <target> [--lang <xx>]` (program name excluded).

    Returns (target, lang). Raises ValueError on any other shape.
    """
    if len(args) < 2 or args[0] != "--manage":
        raise ValueError("expected --manage <target>")
    target = args[1]
    rest = list(args[2:])
    lang = "en"
    if rest:
        if len(rest) != 2 or rest[0] != "--lang":
            raise ValueError("expected --lang <xx>")
        lang = normalize_lang(rest[1])
    return target, lang


def main():
    """Serve protocol requests from stdin until cancel or EOF."""
    for raw in sys.stdin.buffer:
        line = raw.strip()
        if not line:
            continue
        try:
            req = json.loads(line.decode("utf-8"))
            if not isinstance(req, dict):
                raise ValueError("not an object")
        except (ValueError, UnicodeDecodeError):
            emit({"op": "error", "message": tr("invalid_request")})
            continue
        if req.get("op") == "cancel":
            return 0
        try:
            reply = handle_request(req)
        except Refusal as exc:
            reply = {"op": "error", "message": clip(exc)}
        except Exception as exc:  # never crash the loop
            reply = {"op": "error", "message": clip(tr("internal_error", detail=exc))}
        try:
            emit(reply)
        except BrokenPipeError:
            return 0
    return 0


if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] == "--manage":
        try:
            manage_target, manage_lang = parse_manage_args(sys.argv[1:])
        except ValueError:
            sys.exit(2)
        sys.exit(manage_dialog(manage_target, manage_lang))
    try:
        sys.exit(main())
    except (KeyboardInterrupt, BrokenPipeError):
        sys.exit(0)
