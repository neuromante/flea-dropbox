#!/usr/bin/python3 -I
"""Flea menu-action plugin: selective Dropbox sync (stdlib only).

Protocol: newline-delimited JSON on stdin/stdout. Stdout carries protocol
replies only; every child process gets stdout/stderr/stdin redirected away
from it. `--manage <target> [--lang <xx>]` runs the selective-sync dialog
(launched detached by the plugin, never waited for).

Language: the hello message may carry "language"; Italian when it starts
with "it", English otherwise. Requests before hello use English. Every
user-visible text lives in STRINGS, keyed by language.

Test overrides (environment):
  FLEA_DROPBOX_CLI      dropbox-cli binary (default /usr/bin/dropbox-cli)
  FLEA_DROPBOX_INFO     Dropbox info.json (default ~/.dropbox/info.json)
  FLEA_DROPBOX_NO_SPAWN=1  do not launch GUI/browser/clipboard children
"""
import collections
import json
import os
import stat
import subprocess
import sys
import tempfile
import time
import tomllib
from urllib.parse import quote

PROTOCOL_VERSION = 1
MAX_MESSAGE = 300
SHARELINK_BUDGET = 25.0  # seconds for one sharelink request (Flea limit is 30 s)
TREE_MAX_DEPTH = 4       # listed folder levels below the Dropbox root
TREE_MAX_NODES = 3000    # walked folders listed in the dialog
DROPBOX_HOME = "https://www.dropbox.com/home"

DBX_CLI = os.environ.get("FLEA_DROPBOX_CLI") or "/usr/bin/dropbox-cli"
INFO_PATH = os.environ.get("FLEA_DROPBOX_INFO") or os.path.join(
    os.path.expanduser("~"), ".dropbox", "info.json")
NO_SPAWN = os.environ.get("FLEA_DROPBOX_NO_SPAWN") == "1"

PYTHON = "/usr/bin/python3"
WL_COPY = "/usr/bin/wl-copy"
QML = "/usr/bin/qml6"
NOTIFY = "/usr/bin/notify-send"
XDG_OPEN = "/usr/bin/xdg-open"
SYSTEMD_RUN = "/usr/bin/systemd-run"
FC_MATCH = "/usr/bin/fc-match"
SELF = os.path.abspath(__file__)
PICKER = os.path.join(os.path.dirname(os.path.dirname(SELF)), "picker.qml")
THEME_COLORS = os.path.join(os.path.expanduser("~"), ".local", "state", "omarchy",
                            "current", "theme", "colors.toml")

DEVNULL = subprocess.DEVNULL
QML_EXCL = "qml: DBXEXCL "
QML_INCL = "qml: DBXINCL "

# Every user-visible text, per language. Keys starting with "dlg_" are sent to
# the dialog (picker.qml) in the payload's "strings" field. "{name}" marks a
# value filled in by tr(); "{n}" in the dialog keys is filled in by picker.qml.
