    "it": {
        "dropbox_not_found": "Cartella Dropbox non trovata (info.json mancante o non valido).",
        "invalid_paths": "Percorsi non validi.",
        "outside_dropbox": "Il percorso non è nella cartella Dropbox.",
        "unknown_action": "Azione sconosciuta: {action}",
        "nothing_selected": "Nessun elemento selezionato.",
        "window_systemd_timeout": "Impossibile avviare la finestra: systemd-run non risponde.",
        "window_start_failed": "Impossibile avviare la finestra: {detail}",
        "window_open_failed": "Impossibile aprire la finestra: {detail}",
        "window_opened": "Finestra aperta.",
        "opened_home": "Aperto su dropbox.com.",
