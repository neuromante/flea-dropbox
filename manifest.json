{
  "schemaVersion": 1,
  "id": "io.github.neuromante.flea-dropbox",
  "name": "Dropbox – sincronizzazione selettiva",
  "version": "0.2.0",
  "author": "lorenzo nizzi grifi gargiolli",
  "license": "MIT",
  "description": "Escludi cartelle dalla sincronizzazione Dropbox, gestisci le esclusioni, copia i link condivisi e apri su dropbox.com.",
  "kinds": ["menu-action"],
  "menuActions": [
    {
      "id": "exclude",
      "label": "Escludi dalla sincronizzazione",
      "glyph": "eye-off",
      "menus": ["file"],
      "when": {"minItems": 1, "maxItems": 512, "folders": true}
    },
    {
      "id": "manage",
      "label": "Sincronizzazione selettiva Dropbox…",
      "glyph": "cloud-upload",
      "menus": ["file", "background"],
      "when": {"minItems": 0, "maxItems": 1, "folders": true}
    },
    {
      "id": "sharelink",
      "label": "Copia link Dropbox",
      "glyph": "copy",
      "menus": ["file"],
      "when": {"minItems": 1, "maxItems": 10, "folders": true}
    },
    {
      "id": "view",
      "label": "Visualizza su dropbox.com",
      "glyph": "globe",
      "menus": ["file"],
      "when": {"minItems": 1, "maxItems": 1, "folders": true}
    }
  ],
  "access": ["selection", "folder", "notify", "network", "exec:dropbox-cli", "exec:wl-copy", "exec:qml6", "exec:systemd-run", "exec:xdg-open", "exec:notify-send", "exec:fc-match"],
  "entryPoints": {"run": "bin/run"}
}
