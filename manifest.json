{
  "schemaVersion": 1,
  "id": "io.github.neuromante.flea-dropbox",
  "name": "Dropbox Selective Sync",
  "version": "0.3.0",
  "author": "lorenzo nizzi grifi gargiolli",
  "license": "MIT",
  "description": "Choose which Dropbox folders sync to this computer, copy Dropbox links and open items on dropbox.com.",
  "kinds": ["menu-action"],
  "menuActions": [
    {
      "id": "exclude",
      "label": "Exclude from Sync",
      "glyph": "eye-off",
      "menus": ["file"],
      "when": {"minItems": 1, "maxItems": 512, "folders": true}
    },
    {
      "id": "manage",
      "label": "Dropbox Selective Sync…",
      "glyph": "cloud-upload",
      "menus": ["file", "background"],
      "when": {"minItems": 0, "maxItems": 1, "folders": true}
    },
    {
      "id": "sharelink",
      "label": "Copy Dropbox Link",
      "glyph": "copy",
      "menus": ["file"],
      "when": {"minItems": 1, "maxItems": 10, "folders": true}
    },
    {
      "id": "view",
      "label": "View on dropbox.com",
      "glyph": "globe",
      "menus": ["file", "background"],
      "when": {"minItems": 0, "maxItems": 1, "folders": true}
    }
  ],
  "access": ["selection", "folder", "notify", "network", "exec:dropbox-cli", "exec:wl-copy", "exec:qml6", "exec:systemd-run", "exec:xdg-open", "exec:notify-send", "exec:fc-match"],
  "entryPoints": {"run": "bin/run"}
}
